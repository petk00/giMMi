# Port na kojem slusa API server
PORT=3000

# Dopusteni origin(i) za CORS, odvojeni zarezom
CORS_ORIGIN=http://localhost:9000

NODE_ENV=development

# Potpis tokena za prijavu - obavezno promijeniti izvan razvoja
JWT_SECRET=gimmi-dev-secret
JWT_TTL=12h
JWT_TTL_SECONDS=43200

# Pohrana priloga
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# MySQL baza
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gimmi
DB_POOL_LIMIT=10
